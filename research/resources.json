        {
          "stat": "Vigor",
          "softCap1": 40,
          "softCap2": 60,
          "softCap3": null,
          "softCap4": null,
          "wikiUrl": "https://eldenring.wiki.gg/wiki/Vigor",
          "note": "Increases your HP. Getting 40 Vigor early makes the early-mid game much easier. Since you can get a +5 Somber weapon and upgraded flasks early, you can be tanking and killing most enemies with little investment."
        },
        {
          "stat": "Mind",
          "softCap1": 50,
          "softCap2": 60,
          "softCap3": null,
          "softCap4": null,
          "wikiUrl": "https://eldenring.wiki.gg/wiki/Mind",
          "note": "Increases your mana bar. Most builds will be fine between 15-40 Mind depending on how many spells or weapon skills you use."
        },
        {
          "stat": "Endurance",
          "softCap1": 15,
          "softCap2": 30,
          "softCap3": 50,
          "softCap4": null,
          "wikiUrl": "https://eldenring.wiki.gg/wiki/Endurance",
          "note": "Increases your stamina and equip load. Level based on how much stamina and equip load your armor and weapons need. You typically want to end between 30-50 Endurance."
        },
        {
          "stat": "Equip Load (Endurance)",
          "softCap1": 25,
          "softCap2": 60,
          "softCap3": null,
          "softCap4": null,
          "wikiUrl": "https://eldenring.wiki.gg/wiki/Equip_Load"
        },
        {
